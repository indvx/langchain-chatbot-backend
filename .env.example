# LLM Provider ('gemini' or 'openai')
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash
LLM_EMBEDDING_MODEL=models/embedding-001
GOOGLE_API_KEY=
OPENAI_API_KEY=

# WhatsApp (Meta Graph API)
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_URL=https://graph.facebook.com/v22.0

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org

# Database Configuration
DB_CONNECTION=mysql+pymysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_chatbot_db

# Vector Database & Storage
DOCUMENT_DIR_NAME=./documents
VECTOR_DIR_NAME=./vector_db/chroma_langchain_db
CHROMA_COLLECTION_NAME=example_collection
